*.csv
*.json
*.xml
*.sql

# Exclude everything in uploads directory
uploads/
static/uploads/
public/uploads/

# Exclude cache directories
cache/
.cache/

# Exclude session files
sessions/

# Exclude compiled assets
assets/
public/assets/
static/assets/