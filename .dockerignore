bin/
obj/
*.user
*.suo
*.cache
*.docstates

# Monitoring and observability
prometheus/
grafana/
loki/

# Security files
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# Local development files
.local
.dev
.development

# Backup files
*.backup
*.bak
*.old

# Archive files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Video files
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm

# Audio files
*.mp3
*.wav
*.flac
*.aac

# Image files (large ones)
*.psd
*.ai
*.eps
*.tiff
*.bmp

# Font files
*.ttf
*.otf
